@model EmployeeFormViewModel
@{
    ViewData["Title"] = $"Chỉnh sửa nhân viên: {Model.FullName} (BM08)";
}

<div class="row justify-content-center py-3">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1 brand-serif">Chỉnh Sửa Nhân Viên (BM08)</h3>
                <p class="text-muted small mb-0">Cập nhật thông tin, vai trò và trạng thái làm việc</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Danh sách nhân viên
            </a>
        </div>

        <div class="card card-senviet p-4 shadow-sm">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-4" role="alert">
                    <div asp-validation-summary="All" class="mb-0"></div>
                </div>
            }

            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="StaffCode" />
                <input type="hidden" asp-for="Username" />

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="StaffCode" class="form-label small fw-semibold">Mã nhân viên</label>
                        <input asp-for="StaffCode" class="form-control bg-light" readonly />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label small fw-semibold">Tên đăng nhập</label>
                        <input asp-for="Username" class="form-control bg-light" readonly />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label small fw-semibold">Họ và tên *</label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label small fw-semibold">Mật khẩu mới (để trống nếu không đổi)</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Để trống nếu không đổi..." />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Role" class="form-label small fw-semibold">Vị trí / Vai trò *</label>
                        <select asp-for="Role" class="form-select">
                            <option value="@StaffRole.Staff">Phục vụ bàn (Staff)</option>
                            <option value="@StaffRole.Cashier">Thu ngân (Cashier)</option>
                            <option value="@StaffRole.Kitchen">Đầu bếp (Kitchen)</option>
                            <option value="@StaffRole.Manager">Quản lý nhà hàng (Manager)</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ManagerPin" class="form-label small fw-semibold">Mã PIN Quản lý mới (tùy chọn)</label>
                        <input asp-for="ManagerPin" type="password" class="form-control" placeholder="Để trống nếu không đổi..." />
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label small fw-semibold">Số điện thoại *</label>
                        <input asp-for="PhoneNumber" class="form-control" required />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CitizenId" class="form-label small fw-semibold">Số CCCD / CMND *</label>
                        <input asp-for="CitizenId" class="form-control" required />
                        <span asp-validation-for="CitizenId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <div class="form-check form-switch pt-2">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" id="activeSwitch">
                        <label class="form-check-label fw-semibold" for="activeSwitch">Tài khoản nhân viên đang hoạt động</label>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light border px-4">Hủy</a>
                    <button type="submit" class="btn btn-sen-primary px-4 fw-semibold shadow">
                        <i class="bi bi-check-lg me-1"></i> Lưu Thay Đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
