@model EmployeeListViewModel
@{
    ViewData["Title"] = "Quản lý nhân viên (BM08)";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 brand-serif">Quản Lý Nhân Sự (BM08)</h3>
        <p class="text-muted small mb-0">Danh sách nhân viên, phân quyền vai trò và trạng thái tài khoản</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Create" class="btn btn-sen-primary fw-semibold">
            <i class="bi bi-person-plus-fill me-1"></i> Thêm nhân viên mới (BM08)
        </a>
    </div>
</div>

<div class="card card-senviet p-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light small">
                <tr>
                    <th>Mã NV</th>
                    <th>Họ và Tên</th>
                    <th>Tên Đăng Nhập</th>
                    <th>Vai Trò</th>
                    <th>Số Điện Thoại</th>
                    <th>Số CCCD</th>
                    <th class="text-center">Trạng Thái</th>
                    <th class="text-end">Thao Tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Staffs)
                {
                    <tr>
                        <td><strong>@s.StaffCode</strong></td>
                        <td class="fw-semibold text-dark">@s.FullName</td>
                        <td><code>@s.Username</code></td>
                        <td>
                            <span class="badge @(s.Role == StaffRole.Manager ? "bg-danger" : s.Role == StaffRole.Cashier ? "bg-success" : s.Role == StaffRole.Kitchen ? "bg-warning text-dark" : "bg-primary")">
                                @(s.Role switch
                                {
                                    StaffRole.Manager => "Quản lý",
                                    StaffRole.Cashier => "Thu ngân",
                                    StaffRole.Kitchen => "Đầu bếp",
                                    _ => "Phục vụ bàn"
                                })
                            </span>
                        </td>
                        <td>@s.PhoneNumber</td>
                        <td>@s.CitizenId</td>
                        <td class="text-center">
                            <span class="badge @(s.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                @(s.IsActive ? "Đang làm việc" : "Đã nghỉ việc")
                            </span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="Sửa thông tin">
                                <i class="bi bi-pencil"></i> Sửa
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
