@model InvoiceDto
@{
    ViewData["Title"] = $"Hóa đơn VAT: {Model.InvoiceCode} (BM05)";
}

<div class="d-flex justify-content-between align-items-center mb-4 no-print">
    <div>
        <h3 class="fw-bold mb-1 brand-serif">Hóa Đơn Thanh Toán (BM05)</h3>
        <p class="text-muted small mb-0">Hóa đơn bán lẻ kiêm chứng từ thu tiền chính thức của Nhà hàng Sen Việt</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Floor" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-grid-3x3-gap me-1"></i> Về sơ đồ bàn
        </a>
        <button type="button" class="btn btn-sen-primary" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In hóa đơn VAT (Print)
        </button>

        @if (User.IsInRole(nameof(StaffRole.Manager)) && Model.Status == InvoiceStatus.Paid)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#cancelInvoiceModal">
                <i class="bi bi-x-circle me-1"></i> Hủy hóa đơn (Quản lý)
            </button>
        }
    </div>
</div>

<div class="receipt-paper">
    <div class="receipt-header">
        <div class="fs-4 fw-bold text-uppercase">NHÀ HÀNG SEN VIỆT</div>
        <div class="small">123 Đường Sen Vàng, P. Bến Nghé, Quận 1, TP. HCM</div>
        <div class="small">Mã số thuế: <strong>0312345678</strong> &bull; Hotline: 1900 6868</div>
        <div class="fs-5 fw-bold mt-2 text-uppercase text-danger">HÓA ĐƠN BÁN LẺ (VAT)</div>
        <div class="small">Số HĐ: <strong>@Model.InvoiceCode</strong></div>
        <div class="small">Thời gian: @Model.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss dd/MM/yyyy")</div>
    </div>

    <div class="small mb-3">
        <div class="d-flex justify-content-between">
            <span>Bàn: <strong>@Model.TableNumber (@Model.AreaName)</strong></span>
            <span>Mã Order: <strong>@Model.OrderCode</strong></span>
        </div>
        <div class="d-flex justify-content-between">
            <span>Khách hàng: <strong>@(Model.CustomerName ?? "Khách lẻ")</strong></span>
            <span>SĐT: @(Model.CustomerPhone ?? "-")</span>
        </div>
        @if (Model.MembershipRank != MembershipRank.Standard)
        {
            <div class="text-success fw-bold">
                Hạng thành viên: @Model.MembershipRank
            </div>
        }
        <div class="d-flex justify-content-between">
            <span>Thu ngân: @Model.StaffName</span>
            <span>Phương thức: <strong>@Model.PaymentMethod</strong></span>
        </div>
    </div>

    <div class="small border-top border-bottom py-2 my-2">
        <div class="d-flex justify-content-between py-1">
            <span>Tổng tiền món ăn:</span>
            <span>@Model.ItemsTotal.ToString("N0") VNĐ</span>
        </div>

        @if (Model.SurchargeAmount > 0)
        {
            <div class="d-flex justify-content-between py-1 text-danger">
                <span>Phụ thu cao điểm (T7/CN):</span>
                <span>+@Model.SurchargeAmount.ToString("N0") VNĐ</span>
            </div>
        }

        <div class="d-flex justify-content-between py-1">
            <span>Thuế GTGT (VAT 8%):</span>
            <span>+@Model.VatAmount.ToString("N0") VNĐ</span>
        </div>

        @if (Model.MemberDiscountAmount > 0)
        {
            <div class="d-flex justify-content-between py-1 text-success">
                <span>Giảm giá thành viên (@Model.MembershipRank):</span>
                <span>-@Model.MemberDiscountAmount.ToString("N0") VNĐ</span>
            </div>
        }

        @if (Model.DepositDeducted > 0)
        {
            <div class="d-flex justify-content-between py-1 text-primary fw-bold">
                <span>Đã trừ tiền cọc đặt bàn:</span>
                <span>-@Model.DepositDeducted.ToString("N0") VNĐ</span>
            </div>
        }

        <div class="d-flex justify-content-between pt-2 border-top border-2 border-dark fs-5 fw-bold">
            <span>TỔNG TIỀN ĐÃ THU:</span>
            <span class="text-danger">@Model.FinalAmount.ToString("N0") VNĐ</span>
        </div>

        @if (Model.PaymentMethod == PaymentMethod.Cash && Model.CashReceived.HasValue)
        {
            <div class="d-flex justify-content-between pt-1">
                <span class="text-muted">Tiền khách đưa:</span>
                <span>@Model.CashReceived.Value.ToString("N0") VNĐ</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Tiền thối lại:</span>
                <span>@(Model.ChangeAmount?.ToString("N0") ?? "0") VNĐ</span>
            </div>
        }
    </div>

    <div class="receipt-footer small">
        <div class="fw-bold">CẢM ƠN QUÝ KHÁCH VÀ HẸN GẶP LẠI!</div>
        <div class="fst-italic mt-1">Hóa đơn điện tử khởi tạo từ máy tính tiền kết nối dữ liệu Tổng cục Thuế</div>
    </div>
</div>

<!-- Modal Hủy Hóa Đơn -->
@if (User.IsInRole(nameof(StaffRole.Manager)))
{
    <div class="modal fade" id="cancelInvoiceModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content card-senviet">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">Hủy Hóa Đơn Đã Thanh Toán</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <form asp-action="Cancel" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="InvoiceId" value="@Model.Id" />
                    <input type="hidden" name="InvoiceCode" value="@Model.InvoiceCode" />

                    <div class="modal-body">
                        <div class="alert alert-warning small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Hành động này sẽ hủy hóa đơn <strong>@Model.InvoiceCode</strong>, ghi nhận vào nhật ký kiểm toán và yêu cầu Quản lý nhập mã PIN.
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Lý do hủy hóa đơn *</label>
                            <input type="text" name="Reason" class="form-control" placeholder="Nhập lý do hủy..." required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Mã PIN Quản lý *</label>
                            <input type="password" name="ManagerPin" class="form-control" placeholder="Nhập mã PIN (1234)..." required />
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-danger fw-semibold">Xác nhận hủy hóa đơn</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
