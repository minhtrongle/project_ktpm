@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card card-senviet p-5 border-0">
            <div class="display-1 text-danger mb-3"><i class="bi bi-shield-x"></i></div>
            <h2 class="fw-bold mb-2">Truy cập bị từ chối</h2>
            <p class="text-muted mb-4">
                Tài khoản của bạn không có đủ thẩm quyền để truy cập biểu mẫu hoặc thao tác này.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Floor" asp-action="Index" class="btn btn-sen-primary">
                    <i class="bi bi-arrow-left me-1"></i> Trở về Sơ đồ bàn
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    Trang chủ
                </a>
            </div>
        </div>
    </div>
</div>
