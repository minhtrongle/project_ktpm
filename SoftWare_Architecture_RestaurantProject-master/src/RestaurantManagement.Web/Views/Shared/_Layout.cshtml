@using System.Security.Claims
@using RestaurantManagement.Common.Enums
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nhà Hàng Sen Việt</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom Theme CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top no-print">
        <nav class="navbar navbar-expand-lg navbar-senviet">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="fs-3 text-danger"><i class="bi bi-flower1"></i></span>
                    <div>
                        <div class="brand-logo lh-1">SEN VIỆT</div>
                        <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem; letter-spacing: 1.5px;">Ẩm thực truyền thống</small>
                    </div>
                </a>
                
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Trang chủ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="Search">
                                <i class="bi bi-calendar-check me-1"></i> Đặt bàn (BM12-14)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="Lookup">
                                <i class="bi bi-search me-1"></i> Tra cứu đặt bàn (BM15)
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item border-start ps-lg-2 ms-lg-1 d-none d-lg-block"></li>
                            
                            @if (User.IsInRole(nameof(StaffRole.Staff)) || User.IsInRole(nameof(StaffRole.Cashier)) || User.IsInRole(nameof(StaffRole.Manager)))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-primary fw-semibold" asp-controller="Floor" asp-action="Index">
                                        <i class="bi bi-grid-3x3-gap-fill me-1"></i> Sơ đồ bàn (BM03)
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole(nameof(StaffRole.Cashier)) || User.IsInRole(nameof(StaffRole.Manager)))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-cash-coin me-1"></i> Quầy thu ngân
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-sm">
                                        <li><a class="dropdown-item" asp-controller="Shift" asp-action="Index"><i class="bi bi-clock-history me-2"></i>Ca làm việc hiện tại</a></li>
                                        <li><a class="dropdown-item" asp-controller="Shift" asp-action="Open"><i class="bi bi-box-arrow-in-right me-2"></i>Mở ca (BM04)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Shift" asp-action="Close"><i class="bi bi-check2-circle me-2"></i>Kết ca & Đếm tiền (BM06)</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Shift" asp-action="History"><i class="bi bi-journal-text me-2"></i>Lịch sử các ca</a></li>
                                    </ul>
                                </li>
                            }

                            @if (User.IsInRole(nameof(StaffRole.Kitchen)) || User.IsInRole(nameof(StaffRole.Manager)))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-warning-emphasis fw-semibold" asp-controller="Kitchen" asp-action="Index">
                                        <i class="bi bi-fire me-1"></i> Bếp KDS
                                    </a>
                                </li>
                            }

                            @if (User.IsInRole(nameof(StaffRole.Manager)))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-danger fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                                        <i class="bi bi-gear-fill me-1"></i> Quản trị
                                    </a>
                                    <ul class="dropdown-menu border-0 shadow-sm">
                                        <li><a class="dropdown-item" asp-controller="Menu" asp-action="Index"><i class="bi bi-card-checklist me-2"></i>Quản lý thực đơn (BM07)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Employee" asp-action="Index"><i class="bi bi-people-fill me-2"></i>Quản lý nhân viên (BM08)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Index"><i class="bi bi-calendar-check-fill me-2"></i>Bảng chấm công (BM11)</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Report" asp-action="Revenue"><i class="bi bi-graph-up-arrow me-2 text-success"></i>Báo cáo doanh thu (BM09)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Report" asp-action="BestSellers"><i class="bi bi-trophy-fill me-2 text-warning"></i>Món bán chạy (BM10)</a></li>
                                    </ul>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <!-- Digital Server Clock -->
                        <div class="d-none d-md-flex align-items-center gap-1 text-muted small bg-light px-2 py-1 rounded">
                            <i class="bi bi-clock"></i>
                            <span id="liveClock">--:--:--</span>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var role = User.FindFirstValue(ClaimTypes.Role) ?? "Staff";
                            var fullName = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity.Name;
                            var staffCode = User.FindFirstValue("StaffCode") ?? "";

                            string roleBadgeClass = role switch
                            {
                                "Manager" => "bg-danger text-white",
                                "Cashier" => "bg-success text-white",
                                "Kitchen" => "bg-warning text-dark",
                                _ => "bg-primary text-white"
                            };

                            string roleTitle = role switch
                            {
                                "Manager" => "Quản lý",
                                "Cashier" => "Thu ngân",
                                "Kitchen" => "Đầu bếp",
                                _ => "Phục vụ bàn"
                            };

                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-2 border-0 bg-light" type="button" data-bs-toggle="dropdown">
                                    <div class="avatar-circle bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.8rem;">
                                        <i class="bi bi-person-fill"></i>
                                    </div>
                                    <div class="text-start lh-1">
                                        <div class="fw-semibold text-dark" style="font-size: 0.85rem;">@fullName</div>
                                        <span class="badge @roleBadgeClass" style="font-size: 0.65rem;">@roleTitle (@staffCode)</span>
                                    </div>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm mt-2">
                                    <li><h6 class="dropdown-header">Tài khoản: @User.Identity.Name</h6></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-sen-primary d-flex align-items-center gap-2">
                                <i class="bi bi-person-lock"></i>
                                <span>Đăng nhập Nhân viên</span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 py-3">
        <!-- Toast & Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show card-senviet mb-3 border-0 border-start border-success border-4 shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5 text-success"></i>
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show card-senviet mb-3 border-0 border-start border-danger border-4 shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5 text-danger"></i>
                <strong>Thông báo:</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show card-senviet mb-3 border-0 border-start border-info border-4 shadow-sm" role="alert">
                <i class="bi bi-info-circle-fill me-2 fs-5 text-info"></i>
                @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-white border-top py-4 mt-auto no-print">
        <div class="container-fluid px-lg-4">
            <div class="row align-items-center gy-3">
                <div class="col-md-6 text-center text-md-start">
                    <div class="d-flex align-items-center justify-content-center justify-content-md-start gap-2 mb-1">
                        <span class="text-danger fs-5"><i class="bi bi-flower1"></i></span>
                        <span class="fw-bold text-dark">Nhà Hàng Sen Việt</span>
                        <span class="badge bg-danger-subtle text-danger" style="font-size: 0.7rem;">Hệ thống chuẩn kiến trúc Multi-Tier</span>
                    </div>
                    <small class="text-muted d-block">
                        Địa chỉ: 123 Đường Sen Vàng, Phường Bến Nghé, Quận 1, TP. Hồ Chí Minh &bull; Hotline: 1900 6868
                    </small>
                </div>
                <div class="col-md-6 text-center text-md-end text-muted small">
                    <div>Đồ án Kết thúc học phần: Kiến trúc phần mềm &copy; 2026.</div>
                    <div class="text-secondary" style="font-size: 0.75rem;">Phục vụ 40 bàn &bull; 4 phân khu &bull; Tích hợp đầy đủ BM00 - BM15</div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script>
        function updateLiveClock() {
            const clockEl = document.getElementById('liveClock');
            if (clockEl) {
                const now = new Date();
                clockEl.textContent = now.toLocaleTimeString('vi-VN', { hour12: false });
            }
        }
        setInterval(updateLiveClock, 1000);
        updateLiveClock();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
