@model BestSellersReportViewModel
@{
    ViewData["Title"] = $"Báo cáo món bán chạy ({Model.FromDate:dd/MM/yyyy} - {Model.ToDate:dd/MM/yyyy}) (BM10)";
    var r = Model.Report;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1 brand-serif">Báo Cáo Món Bán Chạy (BM10)</h3>
        <p class="text-muted small mb-0">Xếp hạng món ăn được ưa chuộng nhất và các món có doanh số thấp cần tối ưu</p>
    </div>

    <!-- Date Range Form -->
    <form asp-action="BestSellers" method="get" class="d-flex gap-2 align-items-center">
        <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <span class="text-muted small">&rarr;</span>
        <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">Lọc</button>
    </form>
</div>

<div class="row g-4">
    <!-- Top Sellers Table -->
    <div class="col-lg-7">
        <div class="card card-senviet p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-trophy-fill me-2 text-warning"></i>Top Món Bán Chạy Nhất</h5>
                <span class="badge bg-warning text-dark">Top @r.TopSellers.Count món</span>
            </div>

            @if (!r.TopSellers.Any())
            {
                <div class="text-center py-5 text-muted small">
                    Chưa có dữ liệu gọi món trong khoảng thời gian này.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th style="width: 50px;">Hạng</th>
                                <th>Món Ăn</th>
                                <th>Danh Mục</th>
                                <th class="text-center">Số Lượng Bán</th>
                                <th class="text-end">Doanh Số (VNĐ)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < r.TopSellers.Count; i++)
                            {
                                var item = r.TopSellers[i];
                                <tr>
                                    <td>
                                        @if (i == 0)
                                        {
                                            <span class="badge bg-warning text-dark rounded-circle p-2"><i class="bi bi-award-fill"></i> 1</span>
                                        }
                                        else if (i == 1)
                                        {
                                            <span class="badge bg-secondary text-white rounded-circle p-2">2</span>
                                        }
                                        else if (i == 2)
                                        {
                                            <span class="badge bg-danger text-white rounded-circle p-2">3</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-muted ps-2">@(i + 1)</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold text-dark">@item.ItemName</div>
                                        <small class="text-muted">Mã: @item.ItemCode</small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
                                    <td class="text-center fw-bold fs-6 text-primary">@item.QuantitySold</td>
                                    <td class="text-end fw-bold text-danger">@item.TotalSales.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Low Sales Table -->
    <div class="col-lg-5">
        <div class="card card-senviet p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-graph-down me-2 text-danger"></i>Món Bán Chậm (Cần Điều Chỉnh)</h5>
                <span class="badge bg-light text-muted border">@r.LowSales.Count món</span>
            </div>

            @if (!r.LowSales.Any())
            {
                <div class="text-center py-5 text-muted small">
                    Tất cả các món đều có lượng bán tốt.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Món Ăn</th>
                                <th>Danh Mục</th>
                                <th class="text-center">Đã Bán</th>
                                <th class="text-end">Doanh Số</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in r.LowSales)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.ItemName</div>
                                        <small class="text-muted">Mã: @item.ItemCode</small>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@item.CategoryName</span></td>
                                    <td class="text-center text-muted">@item.QuantitySold</td>
                                    <td class="text-end text-muted">@item.TotalSales.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
