@model RevenueReportViewModel
@{
    ViewData["Title"] = $"Báo cáo doanh thu ({Model.FromDate:dd/MM/yyyy} - {Model.ToDate:dd/MM/yyyy}) (BM09)";
    var r = Model.Report;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1 brand-serif">Báo Cáo Doanh Thu (BM09)</h3>
        <p class="text-muted small mb-0">Thống kê doanh số bán hàng, thuế VAT, phụ thu và phân bổ tiền mặt / chuyển khoản</p>
    </div>

    <!-- Date Range & Export Form -->
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <form asp-action="Revenue" method="get" class="d-flex gap-2 align-items-center">
            <input type="date" name="fromDate" value="@Model.FromDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <span class="text-muted small">&rarr;</span>
            <input type="date" name="toDate" value="@Model.ToDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" />
            <button type="submit" class="btn btn-sm btn-outline-secondary">Lọc</button>
        </form>

        <a asp-action="ExportRevenueCsv" asp-route-fromDate="@Model.FromDate.ToString("yyyy-MM-dd")" asp-route-toDate="@Model.ToDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-success fw-semibold">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất CSV (BM09)
        </a>
    </div>
</div>

<!-- Key Revenue Metrics -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card card-senviet p-3 border-start border-danger border-4">
            <small class="text-muted fw-semibold">Tổng Thực Thu (Net Total)</small>
            <div class="h3 fw-bold text-danger mb-1">@r.NetTotal.ToString("N0") VNĐ</div>
            <small class="text-muted">Từ @r.TotalInvoices hóa đơn đã thanh toán</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-senviet p-3 border-start border-success border-4">
            <small class="text-muted fw-semibold">Thu Tiền Mặt</small>
            <div class="h3 fw-bold text-success mb-1">@r.CashTotal.ToString("N0") VNĐ</div>
            <small class="text-muted">Chiếm @(r.NetTotal > 0 ? (r.CashTotal / r.NetTotal * 100).ToString("F1") : "0")% tổng doanh thu</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-senviet p-3 border-start border-primary border-4">
            <small class="text-muted fw-semibold">Chuyển Khoản VietQR</small>
            <div class="h3 fw-bold text-primary mb-1">@r.TransferTotal.ToString("N0") VNĐ</div>
            <small class="text-muted">Chiếm @(r.NetTotal > 0 ? (r.TransferTotal / r.NetTotal * 100).ToString("F1") : "0")% tổng doanh thu</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-senviet p-3 border-start border-warning border-4">
            <small class="text-muted fw-semibold">Thuế VAT (8%) Đã Thu</small>
            <div class="h3 fw-bold text-warning-emphasis mb-1">@r.VatTotal.ToString("N0") VNĐ</div>
            <small class="text-muted">Phụ thu cao điểm: @r.SurchargeTotal.ToString("N0") đ</small>
        </div>
    </div>
</div>

<!-- Daily Breakdown Table -->
<div class="card card-senviet p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-calendar3 me-2 text-danger"></i>Chi Tiết Doanh Thu Từng Ngày</h5>
        <span class="badge bg-light text-dark border">@r.DailyBreakdown.Count ngày phát sinh</span>
    </div>

    @if (!r.DailyBreakdown.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-graph-down display-5 mb-2 d-block opacity-50"></i>
            Không có dữ liệu hóa đơn trong khoảng thời gian đã chọn.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Ngày</th>
                        <th class="text-center">Số Hóa Đơn</th>
                        <th class="text-end">Tiền Món</th>
                        <th class="text-end">Phụ Thu</th>
                        <th class="text-end">Thuế VAT (8%)</th>
                        <th class="text-end">Giảm Giá</th>
                        <th class="text-end fw-bold">Thực Thu</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in r.DailyBreakdown)
                    {
                        <tr>
                            <td><strong>@d.Date.ToString("dd/MM/yyyy")</strong></td>
                            <td class="text-center">@d.InvoicesCount</td>
                            <td class="text-end">@d.GrossAmount.ToString("N0") đ</td>
                            <td class="text-end text-danger">@(d.SurchargeAmount > 0 ? $"+{d.SurchargeAmount:N0} đ" : "-")</td>
                            <td class="text-end">@d.VatAmount.ToString("N0") đ</td>
                            <td class="text-end text-success">@(d.DiscountAmount > 0 ? $"-{d.DiscountAmount:N0} đ" : "-")</td>
                            <td class="text-end fw-bold text-danger">@d.FinalAmount.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-light">
                    <tr class="fw-bold">
                        <th>TỔNG CỘNG:</th>
                        <th class="text-center">@r.TotalInvoices</th>
                        <th class="text-end">@r.GrossTotal.ToString("N0") đ</th>
                        <th class="text-end text-danger">+@r.SurchargeTotal.ToString("N0") đ</th>
                        <th class="text-end">@r.VatTotal.ToString("N0") đ</th>
                        <th class="text-end text-success">-@r.DiscountTotal.ToString("N0") đ</th>
                        <th class="text-end text-danger fs-5">@r.NetTotal.ToString("N0") VNĐ</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>
