@model AttendanceListViewModel
@{
    ViewData["Title"] = $"Bảng chấm công ngày {Model.SelectedDate:dd/MM/yyyy} (BM11)";
    var totalStaffs = Model.Attendances.Count;
    var lateStaffs = Model.Attendances.Count(a => a.IsLate);
    var onTimeStaffs = totalStaffs - lateStaffs;
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
        <h3 class="fw-bold mb-1 brand-serif">Bảng Chấm Công Nhân Sự (BM11)</h3>
        <p class="text-muted small mb-0">Theo dõi thời gian vào ca, kiểm soát đi trễ và phê duyệt giải trình</p>
    </div>

    <!-- Date Filter -->
    <form asp-action="Index" method="get" class="d-flex gap-2 align-items-center">
        <label class="small fw-semibold text-muted text-nowrap">Chọn ngày:</label>
        <input type="date" name="date" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" class="form-control form-control-sm" onchange="this.form.submit()" />
        <button type="submit" class="btn btn-sm btn-outline-secondary">Xem</button>
    </form>
</div>

<!-- Attendance Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card card-senviet p-3 border-start border-primary border-4">
            <small class="text-muted fw-semibold">Tổng Số Nhân Viên Vào Ca</small>
            <div class="h3 fw-bold text-primary mb-0">@totalStaffs</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-senviet p-3 border-start border-success border-4">
            <small class="text-muted fw-semibold">Đúng Giờ</small>
            <div class="h3 fw-bold text-success mb-0">@onTimeStaffs</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-senviet p-3 border-start border-danger border-4">
            <small class="text-muted fw-semibold">Đi Trễ (> 15 phút theo LatePolicy)</small>
            <div class="h3 fw-bold text-danger mb-0">@lateStaffs</div>
        </div>
    </div>
</div>

<!-- Attendance Table -->
<div class="card card-senviet p-3">
    @if (!Model.Attendances.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-calendar-x display-5 mb-2 d-block opacity-50"></i>
            Chưa có lượt chấm công nào trong ngày @Model.SelectedDate.ToString("dd/MM/yyyy").
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small">
                    <tr>
                        <th>Mã NV</th>
                        <th>Họ và Tên</th>
                        <th>Vai Trò</th>
                        <th>Giờ Chấm Công</th>
                        <th>Tình Trạng</th>
                        <th>Ghi Chú</th>
                        <th>Duyệt Giải Trình</th>
                        <th class="text-end">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.Attendances)
                    {
                        <tr>
                            <td><strong>@a.StaffCode</strong></td>
                            <td class="fw-semibold text-dark">@a.StaffName</td>
                            <td>
                                <span class="badge @(a.Role == StaffRole.Manager ? "bg-danger" : a.Role == StaffRole.Cashier ? "bg-success" : a.Role == StaffRole.Kitchen ? "bg-warning text-dark" : "bg-primary")">
                                    @a.Role
                                </span>
                            </td>
                            <td>
                                <strong>@a.CheckInTime.ToLocalTime().ToString("HH:mm:ss")</strong>
                            </td>
                            <td>
                                @if (a.IsLate)
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-exclamation-circle me-1"></i> Trễ @a.LateMinutes phút
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-check-circle me-1"></i> Đúng giờ
                                    </span>
                                }
                            </td>
                            <td class="small text-muted">@(a.Note ?? "-")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(a.ApprovedByName))
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="bi bi-check-all me-1"></i> Đã duyệt bởi @a.ApprovedByName
                                    </span>
                                }
                                else if (a.IsLate)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis">
                                        Chờ Quản lý duyệt
                                    </span>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (a.IsLate && string.IsNullOrEmpty(a.ApprovedByName))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="openApproveModal(@a.Id, '@a.StaffName', @a.LateMinutes)">
                                        <i class="bi bi-check2-circle me-1"></i> Duyệt đi trễ
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Duyệt Đi Trễ (Manager PIN Required) -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content card-senviet">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Duyệt Giải Trình Đi Trễ (BM11)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="Approve" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="approveAttendanceId" name="AttendanceId" />
                <input type="hidden" id="approveStaffName" name="StaffName" />

                <div class="modal-body">
                    <div class="alert alert-light border small mb-3">
                        Nhân viên: <strong id="approveDisplayStaff" class="text-danger"></strong>
                        &bull; Số phút đi trễ: <strong id="approveDisplayLate" class="text-danger"></strong> phút
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do chấp thuận đi trễ *</label>
                        <input type="text" name="Reason" class="form-control" placeholder="Ví dụ: Kẹt xe có báo trước / Công việc đột xuất..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mã PIN Quản lý (xác thực) *</label>
                        <input type="password" name="ManagerPin" class="form-control" placeholder="Nhập PIN (1234)..." required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-sen-primary fw-semibold">Xác nhận duyệt</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openApproveModal(id, staffName, lateMinutes) {
            document.getElementById('approveAttendanceId').value = id;
            document.getElementById('approveStaffName').value = staffName;
            document.getElementById('approveDisplayStaff').textContent = staffName;
            document.getElementById('approveDisplayLate').textContent = lateMinutes;
            new bootstrap.Modal(document.getElementById('approveModal')).show();
        }
    </script>
}
